{
  "name": "selah-live",
  "description": "Proyección, músicos y transmisión en vivo para iglesias",
  "author": "Emanuel — Selah Live",
  "version": "0.5.26",
  "minApk": "0.5.26",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev --webpack -H 0.0.0.0",
    "build": "next build",
    "test": "node --test test/*.test.js",
    "lint": "eslint app components context lib --max-warnings=0",
    "start": "next start -H 0.0.0.0 -p 3000",
    "electron:dev": "npm run build && electron electron/main.js",
    "electron:build:win": "npm run build && electron-builder --win --publish always --config electron-builder.json",
    "apk": "node scripts/build-apk.mjs",
    "apk:debug": "node scripts/build-apk.mjs debug",
    "ota": "node scripts/build-ota.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.0",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/push-notifications": "^8.1.1",
    "@capgo/capacitor-updater": "^8.51.14",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.108.2",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "next": "^16.2.1",
    "obs-websocket-js": "^5.0.8",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
